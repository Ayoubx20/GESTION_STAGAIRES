# ==================== SERVER CONFIGURATION ====================
# Port sur lequel le serveur va écouter
PORT=5000

# Environnement: development, production, test
NODE_ENV=development

# URL du frontend pour CORS
FRONTEND_URL=http://localhost:5173

# ==================== DATABASE CONFIGURATION ====================
# MongoDB Atlas (Cloud)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?options
MONGODB_URI=mongodb+srv://ayoubaboujama_user:A5ba8a20@cluster0.jfsilsf.mongodb.net/gestion-stagiaire?retryWrites=true&w=majority&appName=Cluster0

# Alternative pour MongoDB local (commenté)
# MONGODB_URI=mongodb://127.0.0.1:27017/gestion_stagiaire

# ==================== JWT CONFIGURATION ====================
# Clé secrète pour signer les tokens JWT (à changer en production)
JWT_SECRET=gestion_stagiaire_super_secret_key_2024

# Durée d'expiration des tokens (30d = 30 jours)
JWT_EXPIRE=30d

# ==================== UPLOAD CONFIGURATION ====================
# Taille maximale des fichiers uploadés (5MB en bytes)
MAX_FILE_SIZE=5242880

# Types de fichiers autorisés pour les CV
ALLOWED_FILE_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ==================== EMAIL CONFIGURATION ====================
# Votre adresse Gmail (ex: votre_adresse@gmail.com)
EMAIL_USER=ayou.ayou217@gmail.com
# Mot de passe d'application généré par Google (16 caractères)
